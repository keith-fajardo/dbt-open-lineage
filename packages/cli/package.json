    "@types/react-dom": "^19.2.3",
    "@vitejs/plugin-react": "^6.0.2",
    "esbuild": "^0.27.0",
    "jsdom": "^29.1.1",
    "typescript": "^5.6.0",
    "vite": "^8.0.16",
    "vitest": "^4.1.10"
  }
}
